BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
MAX_DURATION_SECONDS=900
DOWNLOAD_DIR=downloads
DATABASE_PATH=bot_database.db
ADMIN_IDS=

# Docker image buni avtomatik o'rnatadi. Lokal ishga tushirganda bo'sh qoldiring.
POT_PROVIDER_HOME=

# Cookies. DIQQAT: repo ochiq - cookies faylini hech qachon commit qilmang.
# Ikki usuldan BITTASINI tanlang:
#   1) Hosting "secret file" beradi  -> faylni yuklang va yo'lini yozing:
#      YTDLP_COOKIES_FILE=/etc/secrets/cookies.txt
#   2) Faqat env o'zgaruvchisi bor   -> base64 qilib joylashtiring:
#      base64 -i cookies.txt | pbcopy     (macOS)
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=

# Ixtiyoriy: residential proxy (cookies ham yetarli bo'lmasa).
YTDLP_PROXY=
