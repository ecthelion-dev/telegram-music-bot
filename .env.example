BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
MAX_DURATION_SECONDS=900
DOWNLOAD_DIR=downloads
DATABASE_PATH=bot_database.db
ADMIN_IDS=

# Docker image buni avtomatik o'rnatadi. Lokal ishga tushirganda bo'sh qoldiring.
POT_PROVIDER_HOME=

# Ixtiyoriy: PO token yetarli bo'lmasa (IP qattiq bloklangan bo'lsa) ishlatiladi.
# Cookies fayli Netscape formatida bo'lishi kerak (yt-dlp --cookies).
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
